# HealPlus Intake Image API - Environment Variables

# Local Docker Compose database
DATABASE_URL=postgresql+psycopg://healplus:CHANGE_ME@localhost:5432/healplus
FHIR_BASE_URL=http://127.0.0.1:8000/api/fhir/r4
POSTGRES_PASSWORD=CHANGE_ME

# Development/Production
# Gere um segredo diferente por cliente com python -c "import secrets; print(secrets.token_urlsafe(32))"
# Configure o JSON abaixo no ambiente; vazio mantém as rotas clínicas fechadas.
API_CLIENT_TOKENS={}
REQUIRE_HTTPS=false
MAX_REQUEST_BYTES=33554432
ANALYSIS_TIMEOUT_SECONDS=120
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_RETRY_BASE_SECONDS=2
ANALYSIS_LEASE_SECONDS=60
WORKER_POLL_SECONDS=1.0
